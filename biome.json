{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/src/generated/**", "!**/.next/**", "!**/dist/**", "!**/coverage/**", "!**/*.css", "!**/public/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "warn", "useExhaustiveDependencies": "off" },
      "style": { "useImportType": "error", "useConst": "error" },
      "suspicious": { "noDebugger": "error", "noDoubleEquals": { "level": "error", "options": { "ignoreNull": true } } },
      "performance": { "noDelete": "error" }
    }
  }
}
