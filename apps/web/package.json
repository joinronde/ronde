    "push-keys": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('WEB_PUSH_PUBLIC_KEY='+k.publicKey+'\\nWEB_PUSH_PRIVATE_KEY='+k.privateKey)\""
  },
