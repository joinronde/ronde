# PostgreSQL database
DATABASE_URL=postgres://ronde:ronde@localhost:5434/ronde

# Public URL of the app, prefix included (links in reminder emails)
APP_URL=http://localhost:3000

# Language used when neither the viewer nor their browser picks one (en, fr)
DEFAULT_LOCALE=en

# ─── Accounts ────────────────────────────────────────────────────────────────
# Secret signing sessions and email links, at least 32 characters (openssl rand -base64 32).
# Empty locally: a development secret is used. Required in production.
AUTH_SECRET=
# Who may create an account: invite-only (default), open, or domains (SIGNUP_ALLOWED_DOMAINS).
# The very first account is always allowed: it becomes the instance administrator.
SIGNUP_POLICY=invite-only
# SIGNUP_ALLOWED_DOMAINS=example.com, example.org

# Single sign-on with one OpenID Connect provider (Keycloak, Authentik, Entra ID, Okta…)
# Redirect URI to register at the provider: <APP_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://sso.example.com/realms/acme
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Acme SSO
# OIDC_SCOPES=openid profile email
# OIDC_DISCOVERY_URL=   (default: <OIDC_ISSUER>/.well-known/openid-configuration)

# Social sign-in, each provider on when both values are set.
# Redirect URI: <APP_URL>/api/auth/callback/<google|github|microsoft>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Behind an authenticating reverse proxy only: header carrying the signed-in person's email.
# Accounts are then created on first visit. Never set it on an instance reachable without the proxy.
# AUTH_TRUSTED_EMAIL_HEADER=x-auth-request-email

# Reverse proxies in front of Ronde (CIDR ranges, e.g. the Docker network): the sign-in rate limit then reads
# the client's address behind them in X-Forwarded-For
# RONDE_TRUSTED_PROXIES=10.0.0.0/8

# Sites allowed to show Ronde in a frame (Content-Security-Policy frame-ancestors). Default: Ronde itself only.
# RONDE_FRAME_ANCESTORS='self' https://signage.example.org

# Addresses people configure (webhooks, GitLab, calendars, video, speech-to-text): on a private network they are
# reached by default here, never in the cloud. Block them anyway, or let named hosts through when blocked.
# RONDE_BLOCK_PRIVATE_URLS=1
# RONDE_OUTBOUND_ALLOW=gitlab.internal,chat.internal

# ─── Background jobs ─────────────────────────────────────────────────────────
# A live session left open this many hours closes by itself, its minutes kept as a draft for the hosts (0: never). Default 12
# RONDE_AUTO_CLOSE_HOURS=12
# Days a draft of the minutes waits before its hosts are reminded of it under the bell (0: never). Default 2
# RONDE_DRAFT_REMIND_DAYS=2
# Reminders and next sessions run in the web process (pg-boss, schema "pgboss"). "off": another process runs them
# RONDE_JOBS=off

# ─── Plans ───────────────────────────────────────────────────────────────────
# Public site presenting the paid plans, linked from the module catalog (admins only)
# RONDE_SITE_URL=https://joinronde.com
# Hide every mention of the paid plans
# RONDE_HIDE_UPGRADE_HINTS=1
# "Send feedback" button, off on a self-hosted instance: on shows it, the messages going to the instance's
# administrators (Server administration), and to Sentry when SENTRY_DSN is set
# RONDE_FEEDBACK=on

# ─── Email ───────────────────────────────────────────────────────────────────
# Sign-in links, invitations and reminders: smtp://user:pass@smtp.example.com:587
# Without it, emails (and their links) are written to the server log and addresses are not verified.
SMTP_URL=
MAIL_FROM=Ronde <ronde@example.com>

# Encryption key for stored secrets: GitLab tokens, notification connectors (at least 32 characters).
# Empty locally: a development key is used. Required in production to save tokens.
SECRET_KEY=

# GitLab (optional): the server connections reach when none is typed. Connections are made in the workspace's
# settings (every meeting may use them) or in a meeting's (its own); GITLAB_TOKEN is the instance's connection,
# used while a workspace has none
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
# "Connect with GitLab" (recommended): an OAuth application of the GitLab server, scopes read_api and read_user,
# redirect URI <APP_URL>/api/gitlab/oauth. Admins and hosts then connect an account: no personal token that expires
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# ─── Paid plans ──────────────────────────────────────────────────────────────
# A Team or Enterprise license key (also accepted on the administration page)
# RONDE_LICENSE=

# ─── AI assistant and transcripts (Team) ─────────────────────────────────────
# A key for every workspace; each workspace may bring its own in its settings
# ANTHROPIC_API_KEY=
# Speech to text with the OpenAI API, or a self-hosted Whisper server (TRANSCRIPTION_URL=http://localhost:8000/v1)
# TRANSCRIPTION_URL=
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_API_KEY=

# ─── Slack app (Team) ────────────────────────────────────────────────────────
# The instance's app, created from docker/slack-manifest.yml; Slack must reach APP_URL over HTTPS
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# ─── Error reports and audience measure (optional) ───────────────────────────
# Sentry: errors of the server and the browsers, without people's data (SENTRY_TRACES_SAMPLE_RATE: 0 to 1)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# Umami: page views and a few named steps, without cookies; addresses lose workspace and meeting names
# UMAMI_SCRIPT_URL=
# UMAMI_WEBSITE_ID=
# UMAMI_DOMAINS=

# ─── Screen sharing to the room ──────────────────────────────────────────────
# STUN/TURN servers as JSON; a public STUN server by default, [] for none
# RONDE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# ─── Ronde cloud only ────────────────────────────────────────────────────────
# Each workspace has its own plan, billed with Stripe (never on a self-hosted instance)
# RONDE_CLOUD=1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Prices of a Team seat (per person who took part in a meeting in the last 30 days), set up in Stripe:
# monthly, and yearly (optional)
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_TEAM_YEARLY=

# URL prefix, read at build time (pnpm build / docker build): empty = root
# NEXT_PUBLIC_BASE_PATH=/ronde

# Every secret variable also accepts the <NAME>_FILE form
# (e.g. DATABASE_URL_FILE=/run/secrets/ronde_database_url) for Docker secrets.
