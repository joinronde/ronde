{
  "name": "ronde-monorepo",
  "private": true,
  "description": "Ronde: run engaging team meetings. Open-core monorepo (the product and its packages).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joinronde/ronde.git"
  },
  "homepage": "https://joinronde.com",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ronde/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "biome check . && node scripts/check-ee-boundary.mjs",
    "format": "biome format --write .",
    "check": "biome check . && turbo run typecheck test",
    "check:english": "node scripts/check-english.mjs",
    "check:ee": "node scripts/check-ee-boundary.mjs",
    "build:ce": "RONDE_PURE_CE=1 turbo run build --filter=@ronde/web && node scripts/check-pure-ce.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "semantic-release": "^24.2.9",
    "semantic-release-gitmoji": "^1.6.9",
    "turbo": "^2.5.8"
  }
}
