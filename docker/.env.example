# Ronde, self-hosted. Copy to .env next to compose.yml, fill in the three secrets, then: docker compose up -d

# ─── Required ────────────────────────────────────────────────────────────────
# Address people open, without a trailing slash (links in emails and invitations)
RONDE_URL=http://localhost:3000
# Three long random secrets: openssl rand -base64 32
POSTGRES_PASSWORD=
AUTH_SECRET=
# Encrypts the tokens and keys saved in the app (connectors, AI, trackers…)
SECRET_KEY=

# ─── Usual ───────────────────────────────────────────────────────────────────
# Version of the images: "beta" follows the latest beta, or pin one such as 1.0.0-beta.3
RONDE_VERSION=beta
# Port of the app on this machine (without the https profile)
RONDE_PORT=3000
# With the https profile: the domain Caddy gets a certificate for (its DNS must point here)
# RONDE_DOMAIN=ronde.example.com
# Who may create an account: invite-only (default), open, or domains (SIGNUP_ALLOWED_DOMAINS).
# The first account is always allowed: it becomes the instance administrator.
SIGNUP_POLICY=invite-only
# Language when neither the person nor their browser picks one: en, zh, hi, es, ar, fr, pt, ru, de or it
DEFAULT_LOCALE=en

# ─── Email ───────────────────────────────────────────────────────────────────
# Sign-in links, invitations, reminders. With the mail profile: smtp://mail:1025
SMTP_URL=
MAIL_FROM=Ronde <ronde@example.com>

# ─── Single sign-on (optional) ───────────────────────────────────────────────
# One OpenID Connect provider (Keycloak, Authentik, Entra ID…); redirect URI: <RONDE_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://sso.example.com/realms/acme
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Acme SSO
# Google, GitHub, Microsoft: <PROVIDER>_CLIENT_ID and <PROVIDER>_CLIENT_SECRET

# ─── Paid plans (optional) ───────────────────────────────────────────────────
# A Team or Enterprise license key (also accepted on the administration page)
# RONDE_LICENSE=
# Hide every mention of the paid plans
# RONDE_HIDE_UPGRADE_HINTS=1

# ─── AI and transcripts (Team, optional) ─────────────────────────────────────
# A key for every workspace (each workspace may bring its own in its settings)
# ANTHROPIC_API_KEY=
# Speech to text: OpenAI (key), or the whisper profile (no key)
# TRANSCRIPTION_URL=http://whisper:8000/v1
# TRANSCRIPTION_MODEL=Systran/faster-whisper-small
# TRANSCRIPTION_API_KEY=

# ─── Slack app (Team, optional) ──────────────────────────────────────────────
# Create the app from slack-manifest.yml (see the self-hosting guide), then copy its keys here
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# ─── Microsoft Teams app (Team, optional) ────────────────────────────────────
# An Azure Bot registered once in your Microsoft organization (see the self-hosting guide): its application id,
# its tenant, and a client secret (renew it before it expires)
# TEAMS_APP_ID=
# TEAMS_TENANT_ID=
# TEAMS_APP_PASSWORD=

# ─── Error reports and audience measurement (optional) ───────────────────────
# Your own Sentry project: errors of the server and the browsers, without people's data
# SENTRY_DSN=https://<key>@sentry.example.com/1
# SENTRY_ENVIRONMENT=production
# Your own Umami: page views and a few named steps, without cookies; addresses lose workspace and meeting names
# UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# UMAMI_WEBSITE_ID=
# UMAMI_DOMAINS=ronde.example.com

# ─── Screen sharing to the room (optional) ───────────────────────────────────
# STUN/TURN servers as JSON; a public STUN server by default, [] for none
# RONDE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
