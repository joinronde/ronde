{
  "name": "@ronde/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Ronde database: Prisma schema, migrations, generated client and the tenant-scoped client.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./scoped": "./src/scoped.ts",
    "./tenancy": "./src/tenancy.ts",
    "./package.json": "./package.json",
    "./plans": "./src/plans.ts",
    "./migrations": "./src/migrations.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@ronde/config": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
